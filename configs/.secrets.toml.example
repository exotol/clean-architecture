[default]
# Put real secrets into `configs/.secrets.toml` (gitignored).
# This example file must contain NO real credentials.

# Example:
# OPENSEARCH.USER = "admin"
# OPENSEARCH.PASSWORD = "change-me"

# Enable after setting a real key for a model supporting tool calls:
# AGENT.ENABLED = true
# AGENT.API_KEY = "replace-with-your-key"
